# Django Settings
SECRET_KEY=change_me_in_env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOW_ALL=False

# Database (SQLite by default, change for production)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Google OAuth 2.0
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH2_SECRET=your_google_client_secret

# Web Push Notifications (VAPID)
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIM=mailto:admin@yourdomain.com
WEBPUSH_CONTACT_EMAIL=admin@yourdomain.com

# JWT Configuration
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Slack Integration (Optional)
SLACK_VERIFICATION_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=


